#!/usr/bin/env python3
"""Alterna privacidade, tracking ou o blur no PIXY Control: `pixy-toggle privacy|tracking|blur`.

Feito para atalhos do GNOME: o atalho global do Electron no X11 não dispara quando o
layout de teclado ativo não é o primeiro da lista. Fala com o app pelo socket Unix;
se o app não estiver aberto, abre no tray já com o pedido, usando o comando que o app
deixou em ~/.config/pixy-control/launcher.json (AppImage, .deb ou código-fonte).
"""
import json, os, socket, subprocess, sys
what = sys.argv[1] if len(sys.argv) > 1 else ""
if what not in ("privacy", "tracking", "blur"):
    sys.exit("uso: pixy-toggle privacy|tracking|blur")
sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "pixy-control.sock")
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(1)
        s.connect(sock)
        s.sendall(what.encode() + b"\n")
except OSError:
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    try:
        with open(os.path.join(config, "pixy-control", "launcher.json")) as f:
            launch = json.load(f)["exec"]
    except (OSError, ValueError, KeyError):
        sys.exit("pixy-toggle: o PIXY Control não está aberto e nunca foi aberto nesta conta")
    subprocess.Popen([*launch, "--hidden", f"--toggle={what}"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
